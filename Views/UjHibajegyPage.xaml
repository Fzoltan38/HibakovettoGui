<Page x:Class="HibaKovetoWpf.Views.UjHibajegyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HibaKovetoWpf.Views"
      mc:Ignorable="d" 
      Title="Új hibajegy" Background="AliceBlue">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Fejléc-->
        <Border Grid.Row="0" Background="Black" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Új hibajegy felvétele" FontSize="22" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="24" Padding="24" VerticalAlignment="Top">
            <StackPanel MaxWidth="520">
                
                <Label Content="Cím"/>
                <TextBox x:Name="CimBox"/>

                <Label Content="Leírás" Margin="0,12"/>
                <TextBox x:Name="LeirasBox" Height="90" VerticalScrollBarVisibility="Auto"/>

                <Label Content="Komponens" Margin="0,12"/>
                
                <ComboBox x:Name="KomponensCombo">
                    <ComboBoxItem Content="UI" IsSelected="True"/>
                    <ComboBoxItem Content="Backend"/>
                    <ComboBoxItem Content="Adatbázis"/>
                    <ComboBoxItem Content="Hálózat"/>
                </ComboBox>

                <Label Content="Súlyosság" Margin="0,12"/>
                
                <ComboBox x:Name="SulyossagCombo">
                    <ComboBoxItem Content="Alacsony" IsSelected="True"/>
                    <ComboBoxItem Content="Közepes"/>
                    <ComboBoxItem Content="Magas"/>
                    <ComboBoxItem Content="Kritikus"/>
                </ComboBox>

                <CheckBox x:Name="SurgosCheckBox" Content="Azonnali beavatkozást igényel" Margin="0,16"/>

                <TextBlock x:Name="HibaText" Foreground="Red" Margin="0,12" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,20">
                    <Button x:Name="MentesGomb" Content="Mentés" Background="Blue" Foreground="White" Click="MentesGomb_Click"/>
                    <Button x:Name="MegseGomb" Content="Mégse" Background="Gray" Foreground="White" Margin="10,0,0,0" Click="MegseGomb_Click"/>
                </StackPanel>
                
            </StackPanel>
        </Border>
    </Grid>
</Page>
