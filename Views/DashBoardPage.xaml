<Page x:Class="HibaKovetoWpf.Views.DashBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HibaKovetoWpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Áttekintés" Background="AliceBlue">

    <Grid Margin="0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Fejléc-->
        <Border Grid.Row="0" Background="Black" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hibakövető" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" | Fejlesztői hibajegy-kezelő " FontSize="14" Foreground="white" VerticalAlignment="Center" Margin="8,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!--Statisztikai kártyák-->
        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Összes hibajegy" FontSize="12" Foreground="Black"/>
                    <TextBlock x:Name="OsszesText" Text="0" FontSize="28" FontWeight="Bold" Foreground="Black"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Nyitott" FontSize="12" Foreground="Black"/>
                    <TextBlock x:Name="NyitottText" Text="0" FontSize="28" FontWeight="Bold" Foreground="Red"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Megoldva" FontSize="12" Foreground="Black"/>
                    <TextBlock x:Name="MegoldvaText" Text="0" FontSize="28" FontWeight="Bold" Foreground="Black"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Megodottság arány" FontSize="12" Foreground="Black"/>
                    <ProgressBar x:Name="MegoldottsagBar" Height="18" Margin="0,8,0,4" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="MegoldottsagText" Text="0%" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!--Nyitott hibajegyek + navigáció-->
        <Grid Grid.Row="2" Margin="24,10,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="16" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock Text="Nyitott hibajegyek" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,10"/>
                    <ListBox x:Name="NyitottHibakListBox" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Button x:Name="UjHibajegyButton" Background="Black" Foreground="White" Content="+ Új hibajegy" Margin="0,0,0,10" Click="UjHibajegyButton_Click"/>
                <Button x:Name="OsszesHibajegyButton" Background="DarkBlue" Foreground="White" Content="Összes hibajegy" Margin="0,0,0,10" Click="OsszesHibajegyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
