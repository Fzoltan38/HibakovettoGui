<Page x:Class="HibaKovetoWpf.Views.HibaListaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hibajegyek" Background="AliceBlue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Összes hibajegy" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="← Vissza az áttekintéshez" Background="Black" Foreground="White" Click="VisszaGomb_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Szűrés:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="SzuroCombo" Width="150" SelectionChanged="SzuroCombo_SelectionChanged">
                <ComboBoxItem Content="Összes" IsSelected="True"/>
                <ComboBoxItem Content="Nyitott"/>
                <ComboBoxItem Content="Megoldott"/>
            </ComboBox>

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Megoldottság: " VerticalAlignment="Center" Foreground="#7A8093"/>
                <ProgressBar x:Name="SzuroProgressBar" Width="100" Height="14" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                <TextBlock x:Name="SzuroSzazalekText" Text="0%" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#7A8093"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,16,0">
                <ListBox x:Name="HibaListBox" BorderThickness="0" SelectionChanged="HibaListBox_SelectionChanged"/>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Részletek" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Label Content="Cím"/>
                    <TextBlock x:Name="ReszletCimText" TextWrapping="Wrap" FontWeight="SemiBold"/>

                    <Label Content="Leírás" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ReszletLeirasText" TextWrapping="Wrap"/>

                    <Label Content="Komponens" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ReszletKomponensText"/>

                    <Label Content="Súlyosság" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ReszletSulyossagText"/>

                    <Label Content="Bejelentve" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ReszletBejelentveText"/>

                    <CheckBox x:Name="ReszletMegoldvaCheckBox" Content="Megoldva" Margin="0,16,0,0" Checked="ReszletMegoldvaCheckBox_Changed" Unchecked="ReszletMegoldvaCheckBox_Changed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
